{
  "name": "@app/logs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Log viewer for on-device session logs.",
  "license": "MIT",
  "exports": {
    "./routes/*": "./src/routes/*.tsx",
    "./state": "./src/state/index.ts",
    "./effects": "./src/effects/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:browser": "chromium-lock vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@lib/design": "workspace:*",
    "@lib/effects": "workspace:*",
    "@lib/holz-idb-backend": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/shell": "workspace:*",
    "@lib/state": "workspace:*",
    "@lib/ui": "workspace:*",
    "@vanilla-extract/css": "catalog:"
  },
  "devDependencies": {
    "@dev/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "catalog:"
  }
}
