{
  "name": "@app/main",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "SolidStart host. Owns routing and the top-level app.",
  "license": "MIT",
  "author": "Jesse Gibson <JesseTheGibson@gmail.com>",
  "homepage": "https://apps.psychollama.io",
  "repository": "github:PsychoLlama/apps",
  "sideEffects": [
    "**/*.css.ts"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build ${BUILD_MODE:+--mode $BUILD_MODE}",
    "start": "vite start",
    "preview": "wrangler dev",
    "typecheck": "tsc && tsc -p src/service-worker/tsconfig.json",
    "deploy": "wrangler deploy",
    "deploy:preview": "rm -f .wrangler/deploy/preview.ndjson && WRANGLER_OUTPUT_FILE_PATH=.wrangler/deploy/preview.ndjson wrangler versions upload --preview-alias \"pr-${PR_NUMBER:?}\"",
    "test:browser": "chromium-lock vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@app/beam": "workspace:*",
    "@app/gallery": "workspace:*",
    "@app/icon-editor": "workspace:*",
    "@app/logs": "workspace:*",
    "@app/qr-scanner": "workspace:*",
    "@app/scratchpad": "workspace:*",
    "@app/settings": "workspace:*",
    "@lib/design": "workspace:*",
    "@lib/holz-idb-backend": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/runtime-config": "workspace:*",
    "@lib/shell": "workspace:*",
    "@lib/theme": "workspace:*",
    "@lib/ui": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/dynamic": "catalog:",
    "solid-js": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@dev/vite-plugin-app": "workspace:*",
    "@dev/vite-plugin-icon-packs": "workspace:*",
    "@dev/vite-plugin-inline-script": "workspace:*",
    "@dev/vite-plugin-instrumentation-scope": "workspace:*",
    "@dev/vite-plugin-pwa": "workspace:*",
    "@dev/vite-plugin-svg-to-png": "workspace:*",
    "@dev/vitest-config": "workspace:*",
    "@solidjs/vite-plugin-nitro-2": "0.3.2",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "wrangler": "catalog:"
  }
}
