{
  "name": "@app/beam",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Encrypted, peer-to-peer sharing of links and files over iroh.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css.ts"
  ],
  "exports": {
    "./routes/*": "./src/routes/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc",
    "test:browser": "chromium-lock vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@crate/p2p": "workspace:*",
    "@crate/qr-code": "workspace:*",
    "@lib/design": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/shell": "workspace:*",
    "@lib/state": "workspace:*",
    "@lib/ui": "workspace:*",
    "@lib/vault": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "idb": "catalog:"
  },
  "devDependencies": {
    "@dev/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "@solidjs/router": "*",
    "solid-js": "*"
  }
}
