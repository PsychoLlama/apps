{
  "name": "@app/beam",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Encrypted, peer-to-peer sharing of links and files over iroh.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css.ts",
    "src/service-worker/index.ts"
  ],
  "exports": {
    "./constants": "./src/constants.ts",
    "./effects": "./src/effects/index.ts",
    "./state": "./src/state/index.ts"
  },
  "config": {
    "localhost": "beam.localhost"
  },
  "scripts": {
    "dev": "vite dev --host ${npm_package_config_localhost:?}",
    "build": "vite build ${BUILD_MODE:+--mode $BUILD_MODE}",
    "start": "vite start",
    "preview": "wrangler dev --ip ${npm_package_config_localhost:?}",
    "typecheck": "tsc && tsc -p src/worker/tsconfig.json && tsc -p src/service-worker/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:browser": "chromium-lock vitest run --config vitest.browser.config.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "rm -f .wrangler/deploy/preview.ndjson && WRANGLER_OUTPUT_FILE_PATH=.wrangler/deploy/preview.ndjson wrangler versions upload --preview-alias \"pr-${PR_NUMBER:?}\""
  },
  "dependencies": {
    "@crate/p2p": "workspace:*",
    "@crate/qr-code": "workspace:*",
    "@lib/assert": "workspace:*",
    "@lib/design": "workspace:*",
    "@lib/effects": "workspace:*",
    "@lib/holz-idb-backend": "workspace:*",
    "@lib/messaging": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/runtime-config": "workspace:*",
    "@lib/service-worker": "workspace:*",
    "@lib/shell": "workspace:*",
    "@lib/state": "workspace:*",
    "@lib/theme": "workspace:*",
    "@lib/ui": "workspace:*",
    "@lib/vault": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "idb": "catalog:",
    "solid-js": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@dev/vite-plugin-substrate": "workspace:*",
    "@dev/vitest-config": "workspace:*",
    "@vanilla-extract/dynamic": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
