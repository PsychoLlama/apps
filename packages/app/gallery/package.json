{
  "name": "@app/gallery",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Design system gallery — browse components and tokens.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css.ts"
  ],
  "exports": {
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build ${BUILD_MODE:+--mode $BUILD_MODE}",
    "start": "vite start",
    "preview": "wrangler dev",
    "typecheck": "tsc",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "rm -f .wrangler/deploy/preview.ndjson && WRANGLER_OUTPUT_FILE_PATH=.wrangler/deploy/preview.ndjson wrangler versions upload --preview-alias \"pr-${PR_NUMBER:?}\""
  },
  "dependencies": {
    "@lib/classnames": "workspace:*",
    "@lib/design": "workspace:*",
    "@lib/gallery": "workspace:*",
    "@lib/holz-idb-backend": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/runtime-config": "workspace:*",
    "@lib/shell": "workspace:*",
    "@lib/state": "workspace:*",
    "@lib/theme": "workspace:*",
    "@lib/ui": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/meta": "*",
    "@solidjs/router": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@dev/vite-plugin-substrate": "workspace:*",
    "@dev/vitest-config": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@vanilla-extract/dynamic": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
