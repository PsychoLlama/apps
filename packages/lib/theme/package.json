{
  "name": "@lib/theme",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Pre-composed color palettes using `@lib/design`.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css.ts",
    "src/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./appearance-toggle": "./src/appearance-toggle.tsx",
    "./constants": "./src/constants.ts",
    "./prelude": "./src/prelude.ts",
    "./runtime": "./src/runtime.ts",
    "./package.json": "./package.json",
    "./meta": "./src/meta.tsx"
  },
  "scripts": {
    "typecheck": "tsc",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@lib/design": "workspace:*",
    "@lib/observability": "workspace:*",
    "@lib/state": "workspace:*",
    "@lib/ui": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "*"
  },
  "devDependencies": {
    "@dev/vitest-config": "workspace:*"
  }
}
