{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.web.json",
    "tsconfig.node.json"
  ],
  "globalPassThroughEnv": [
    "AR_wasm32_unknown_unknown",
    "CC_wasm32_unknown_unknown",
    "CHROMIUM_PATH",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "FORCE_COLOR",
    "CLICOLOR_FORCE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": [".output/**"],
      "outputLogs": "errors-only",
      "env": ["BUILD_MODE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    // Deploys are cached like any other task. The hash follows the build
    // hash, so `turbo run deploy` only ships apps whose build inputs
    // changed. An evicted cache just means a harmless redeploy; a manual
    // `wrangler rollback` sticks until the app's next real change.
    "deploy": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // Uploads a preview version aliased to the PR. `PR_NUMBER` is hashed:
    // a different PR is a different deploy target. The output keeps
    // wrangler's ND-JSON report so a cache hit still restores the preview
    // URL for CI to record.
    "deploy:preview": {
      "dependsOn": ["build"],
      "env": ["PR_NUMBER"],
      "outputs": [".wrangler/deploy/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:unit": {
      // `^build` because some suites import a crate's wasm glue — generated
      // by the crate's build, and gitignored. Without it the suite passes on
      // a machine that happens to have built the crates and fails on a clean
      // checkout.
      "dependsOn": ["^typecheck", "^build"],
      "inputs": ["src/**", "vitest.unit.config.ts", "!src/**/*.test.browser.*"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:browser": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "vitest.browser.config.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#typecheck": {
      "inputs": ["*.ts", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#cargo:clippy": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#cargo:test": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#lint": {
      "inputs": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "!**/node_modules/**",
        "!**/.output/**",
        "!**/dist/**",
        "eslint.config.ts",
        ".gitignore"
      ],
      "outputs": ["node_modules/.cache/eslint/**"],
      "outputLogs": "errors-only"
    },
    "//#knip:dev": {
      "inputs": [
        "packages/**/src/**",
        "packages/*/*/package.json",
        "knip.config.ts",
        "*.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#knip:production": {
      "inputs": [
        "packages/**/src/**",
        "packages/*/*/package.json",
        "knip.config.ts",
        "*.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#fmt-check": {
      "inputs": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css,html,rs}",
        "!**/node_modules/**",
        "!**/.output/**",
        "!target/**",
        "treefmt.toml"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#workspace-check": {
      "env": ["NIX_PNPM_VERSION"],
      "inputs": [
        "package.json",
        "packages/dev/workspace-cli/src/**",
        "packages/*/*/package.json",
        "pnpm-workspace.yaml",
        "turbo.json"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    }
  }
}
